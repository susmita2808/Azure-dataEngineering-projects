{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "realtimehybriddatafactory"
		},
		"LS_Sink_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://realtimestorageaccount.dfs.core.windows.net/"
		},
		"LS_Source_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://realtimestorageaccount.dfs.core.windows.net/"
		},
		"trigger_batch_data_properties_PL_Batch_Ingestion_parameters_fileName": {
			"type": "string",
			"defaultValue": "online_retail.csv"
		},
		"trigger_batch_data_properties_PL_Batch_Ingestion_parameters_sourcePath": {
			"type": "string",
			"defaultValue": "landing/online_retail/"
		},
		"trigger_batch_data_properties_PL_Batch_Ingestion_parameters_sinkPath": {
			"type": "string",
			"defaultValue": "bronze/batch/online_retail/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "realtimehybriddatafactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_Sink_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_Sink_ADLS_properties_typeProperties_url')]"
					},
					"LS_Source_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_Source_ADLS_properties_typeProperties_url')]"
					},
					"trigger_batch_data_properties_PL_Batch_Ingestion_parameters_fileName": {
						"value": "[parameters('trigger_batch_data_properties_PL_Batch_Ingestion_parameters_fileName')]"
					},
					"trigger_batch_data_properties_PL_Batch_Ingestion_parameters_sourcePath": {
						"value": "[parameters('trigger_batch_data_properties_PL_Batch_Ingestion_parameters_sourcePath')]"
					},
					"trigger_batch_data_properties_PL_Batch_Ingestion_parameters_sinkPath": {
						"value": "[parameters('trigger_batch_data_properties_PL_Batch_Ingestion_parameters_sinkPath')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}